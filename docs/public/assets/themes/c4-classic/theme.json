{
  "name": "C4 Classic",
  "description": "Compatibility palette matching the familiar Structurizr/C4 visual language, so diagrams are immediately recognizable as C4 diagrams. Same semantic role -> color mapping as the other curated palettes.",
  "elements": [
    { "tag": "Person",           "shape": "Person", "background": "#08427B", "color": "#FFFFFF", "stroke": "#052E56", "strokeWidth": 2, "border": "Solid" },
