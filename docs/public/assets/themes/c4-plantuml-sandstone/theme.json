    { "tag": "Component",          "shape": "RoundedBox",  "background": "#325d88", "color": "#FFFFFF", "stroke": "#2d547a", "strokeWidth": 2, "border": "Solid" },
    { "tag": "Code",               "shape": "RoundedBox",  "background": "#325d88", "color": "#FFFFFF", "stroke": "#2d547a", "strokeWidth": 2 },
    { "tag": "Deployment Environment", "shape": "RoundedBox", "background": "#f8f5f0", "color": "#3e3f3a", "stroke": "#807e77", "strokeWidth": 1, "border": "Dashed" },
