    { "tag": "Database",           "shape": "Cylinder",    "background": "#f47c3c", "color": "#FFFFFF", "stroke": "#dc7036", "strokeWidth": 2 },
    { "tag": "Cache",              "shape": "RoundedBox",  "background": "#f8f5f0", "color": "#383934", "stroke": "#807e77", "strokeWidth": 2 },
    { "tag": "MessageBroker",      "shape": "Pipe",        "background": "#f47c3c", "color": "#FFFFFF", "stroke": "#dc7036", "strokeWidth": 2 },
    { "tag": "Storage",            "shape": "Folder",      "background": "#f47c3c", "color": "#FFFFFF", "stroke": "#dc7036", "strokeWidth": 2 },
